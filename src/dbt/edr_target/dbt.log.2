\n    pf.status_code,\\n    pf.created_at as forecast_created_at,\\n    pf.updated_at,\\n    pf.valid_from_dttm,\\n    pf.valid_to_dttm\\n    \\nfrom parsed_forecasts pf\\nleft join \\\"weather_dwh\\\".\\\"public\\\".\\\"cities\\\" c\\n    on round(pf.latitude::numeric, 2) = round(c.latitude::numeric, 2)\\n    and round(pf.longitude::numeric, 2) = round(c.longitude::numeric, 2)\\norder by pf.forecast_id, pf.provider, pf.forecast_timestamp\", \"generated_at\": \"2025-12-14 10:23:00\"}, {\"unique_id\": \"model.weather_analytics.ods_weather_forecasts\", \"invocation_id\": \"6bbfb7a7-2c31-4c34-ae7d-ab19db67023a\", \"name\": \"ods_weather_forecasts\", \"schema\": \"ods\", \"status\": \"success\", \"execution_time\": 2.3, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"\\n\\n/*\\n    ODS \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c \\u0434\\u043b\\u044f \\u043f\\u0440\\u043e\\u0433\\u043d\\u043e\\u0437\\u043e\\u0432 \\u043f\\u043e\\u0433\\u043e\\u0434\\u044b \\u043e\\u0442 \\u0440\\u0430\\u0437\\u043d\\u044b\\u0445 \\u043f\\u0440\\u043e\\u0432\\u0430\\u0439\\u0434\\u0435\\u0440\\u043e\\u0432.\\n    \\u0418\\u043d\\u043a\\u0440\\u0435\\u043c\\u0435\\u043d\\u0442\\u0430\\u043b\\u044c\\u043d\\u0430\\u044f \\u0437\\u0430\\u0433\\u0440\\u0443\\u0437\\u043a\\u0430 \\u0441 merge.\\n*/\\n\\nwith source_data as (\\n    select\\n        city,\\n        country,\\n        latitude,\\n        longitude,\\n        provider,\\n        forecast_timestamp,\\n        forecast_run_hour,\\n        hours_ahead,\\n        temperature_celsius,\\n        humidity_percent,\\n        wind_speed_kph,\\n        forecast_created_at,\\n        coalesce(forecast_created_at, forecast_timestamp) as source_changed_at\\n    from \\\"weather_dwh\\\".\\\"stg\\\".\\\"stg_weather_forecast\\\"\\n    where 1 = 1\\n      and hours_ahead in (1, 5, 10, 24, 48, 72, 96, 120, 144, 168)\\n\\n    \\n      and coalesce(forecast_created_at, forecast_timestamp) >= (\\n          select coalesce(max(source_changed_at), '1900-01-01'::timestamp)\\n          from \\\"weather_dwh\\\".\\\"ods\\\".\\\"ods_weather_forecasts\\\"\\n      )\\n    \\n),\\n\\nwith_intervals as (\\n    select\\n        *,\\n        -- \\u0412\\u044b\\u0447\\u0438\\u0441\\u043b\\u044f\\u0435\\u043c\\u044b\\u0435 \\u043f\\u043e\\u043b\\u044f \\u0434\\u043b\\u044f \\u0430\\u043d\\u0430\\u043b\\u0438\\u0442\\u0438\\u043a\\u0438\\n        case \\n            when hours_ahead <= 10 then 'short_term'    -- \\u043a\\u0440\\u0430\\u0442\\u043a\\u043e\\u0441\\u0440\\u043e\\u0447\\u043d\\u044b\\u0439 (\\u0434\\u043e 10 \\u0447\\u0430\\u0441\\u043e\\u0432)\\n            when hours_ahead <= 48 then 'medium_term'   -- \\u0441\\u0440\\u0435\\u0434\\u043d\\u0435\\u0441\\u0440\\u043e\\u0447\\u043d\\u044b\\u0439 (\\u0434\\u043e 2 \\u0434\\u043d\\u0435\\u0439)\\n            else 'long_term'                             -- \\u0434\\u043e\\u043b\\u0433\\u043e\\u0441\\u0440\\u043e\\u0447\\u043d\\u044b\\u0439 (\\u0431\\u043e\\u043b\\u0435\\u0435 2 \\u0434\\u043d\\u0435\\u0439)\\n        end as forecast_horizon_category,\\n        \\n        -- \\u0426\\u0435\\u043b\\u0435\\u0432\\u043e\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u043f\\u0440\\u043e\\u0433\\u043d\\u043e\\u0437\\u0430 (\\u0434\\u043b\\u044f \\u0443\\u0434\\u043e\\u0431\\u0441\\u0442\\u0432\\u0430 join \\u0441 observations)\\n        forecast_run_hour + (hours_ahead || ' hours')::interval as target_datetime\\n    from source_data\\n),\\n\\ndeduped as (\\n    select *\\n    from (\\n        select\\n            *,\\n            row_number() over (\\n                partition by city, provider, forecast_timestamp, hours_ahead\\n                order by source_changed_at desc, forecast_created_at desc nulls last\\n            ) as rn\\n        from with_intervals\\n        where hours_ahead is not null\\n    ) t\\n    where rn = 1\\n)\\n\\nselect\\n    md5(cast(coalesce(cast(city as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(provider as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(forecast_timestamp as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(hours_ahead as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as forecast_id,\\n    city,\\n    country,\\n    latitude,\\n    longitude,\\n    provider,\\n    forecast_timestamp,\\n    forecast_run_hour,\\n    hours_ahead,\\n    \\n    -- \\u0412\\u044b\\u0447\\u0438\\u0441\\u043b\\u044f\\u0435\\u043c\\u044b\\u0435 \\u043f\\u043e\\u043b\\u044f \\u0434\\u043b\\u044f \\u0430\\u043d\\u0430\\u043b\\u0438\\u0442\\u0438\\u043a\\u0438\\n    forecast_horizon_category,\\n    target_datetime,\\n    extract(dow from forecast_timestamp) as forecast_day_of_week,\\n    extract(hour from forecast_timestamp) as forecast_hour_of_day,\\n    date_trunc('day', forecast_run_hour) as forecast_run_date,\\n\\n    -- \\u041e\\u0441\\u043d\\u043e\\u0432\\u043d\\u044b\\u0435 \\u043f\\u0430\\u0440\\u0430\\u043c\\u0435\\u0442\\u0440\\u044b \\u0434\\u043b\\u044f \\u0441\\u0440\\u0430\\u0432\\u043d\\u0435\\u043d\\u0438\\u044f \\u0441 \\u0440\\u0435\\u0430\\u043b\\u044c\\u043d\\u044b\\u043c\\u0438 \\u043d\\u0430\\u0431\\u043b\\u044e\\u0434\\u0435\\u043d\\u0438\\u044f\\u043c\\u0438\\n    temperature_celsius,\\n    humidity_percent,\\n    wind_speed_kph,\\n\\n    -- \\u041c\\u0435\\u0442\\u0430\\u0434\\u0430\\u043d\\u043d\\u044b\\u0435\\n    forecast_created_at,\\n    source_changed_at,\\n    current_timestamp as processed_dttm\\n\\nfrom deduped\", \"generated_at\": \"2025-12-14 10:23:00\"}, {\"unique_id\": \"model.weather_analytics.dm_forecast_pivot\", \"invocation_id\": \"6bbfb7a7-2c31-4c34-ae7d-ab19db67023a\", \"name\": \"dm_forecast_pivot\", \"schema\": \"dm\", \"status\": \"success\", \"execution_time\": 0.5, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"\\n\\n/*\\n    \\u0412\\u0438\\u0442\\u0440\\u0438\\u043d\\u0430 \\u0441 \\u0440\\u0430\\u0437\\u0432\\u0435\\u0440\\u043d\\u0443\\u04