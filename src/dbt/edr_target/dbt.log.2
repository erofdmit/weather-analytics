') || '-' || coalesce(cast(observation_hour as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as observation_id,\\n    city,\\n    country,\\n    latitude,\\n    longitude,\\n    provider,\\n    observation_hour,\\n    \\n    -- \\u0412\\u044b\\u0447\\u0438\\u0441\\u043b\\u044f\\u0435\\u043c\\u044b\\u0435 \\u043f\\u043e\\u043b\\u044f \\u0434\\u043b\\u044f \\u0430\\u043d\\u0430\\u043b\\u0438\\u0442\\u0438\\u043a\\u0438\\n    extract(dow from observation_hour) as day_of_week,\\n    extract(hour from observation_hour) as hour_of_day,\\n    date_trunc('day', observation_hour) as observation_date,\\n\\n    -- \\u041e\\u0441\\u043d\\u043e\\u0432\\u043d\\u044b\\u0435 \\u043f\\u0430\\u0440\\u0430\\u043c\\u0435\\u0442\\u0440\\u044b \\u0434\\u043b\\u044f \\u0441\\u0440\\u0430\\u0432\\u043d\\u0435\\u043d\\u0438\\u044f \\u0441 \\u043f\\u0440\\u043e\\u0433\\u043d\\u043e\\u0437\\u0430\\u043c\\u0438\\n    temperature_celsius,\\n    humidity_percent,\\n    wind_speed_kph,\\n    \\n    -- \\u0414\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0435 \\u043f\\u0430\\u0440\\u0430\\u043c\\u0435\\u0442\\u0440\\u044b\\n    pressure_hpa,\\n    precipitation_mm,\\n    cloud_cover_percent,\\n    visibility_km,\\n    uv_index,\\n    feels_like_celsius,\\n    wind_direction_degrees,\\n    weather_condition,\\n\\n    -- \\u041c\\u0435\\u0442\\u0430\\u0434\\u0430\\u043d\\u043d\\u044b\\u0435\\n    created_at as source_created_at,\\n    updated_at as source_updated_at,\\n    source_changed_at,\\n    current_timestamp as processed_dttm\\n\\nfrom deduped\", \"generated_at\": \"2025-12-14 09:47:50\"}, {\"unique_id\": \"model.weather_analytics.ods_weather_forecasts\", \"invocation_id\": \"37ea2253-dfa8-4480-94ef-771c364aa3a2\", \"name\": \"ods_weather_forecasts\", \"schema\": \"ods\", \"status\": \"success\", \"execution_time\": 2.3, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"\\n\\n/*\\n    ODS \\u043c\\u043e\\u0434\\u0