418\\u0441\\u0442\\u043e\\u0447\\u043d\\u0438\\u043a: stg_weather_current\\n    \\u0426\\u0435\\u043b\\u044c: \\u041d\\u043e\\u0440\\u043c\\u0430\\u043b\\u0438\\u0437\\u043e\\u0432\\u0430\\u043d\\u043d\\u044b\\u0435 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0435 \\u043e \\u0442\\u0435\\u043a\\u0443\\u0449\\u0435\\u0439 \\u043f\\u043e\\u0433\\u043e\\u0434\\u0435 \\u0434\\u043b\\u044f \\u0434\\u0430\\u043b\\u044c\\u043d\\u0435\\u0439\\u0448\\u0435\\u0439 \\u0430\\u043d\\u0430\\u043b\\u0438\\u0442\\u0438\\u043a\\u0438\\n*/\\n\\nwith source_data as (\\n    select\\n        city,\\n        country,\\n        latitude,\\n        longitude,\\n        provider,\\n        observation_time,\\n        temperature_celsius,\\n        humidity_percent,\\n        wind_speed_ms,\\n        wind_speed_kph,\\n        pressure_hpa,\\n        precipitation_mm,\\n        cloud_cover_percent,\\n        visibility_km,\\n        uv_index,\\n        feels_like_celsius,\\n        wind_direction_degrees,\\n        weather_condition,\\n        created_at,\\n        updated_at\\n    from \\\"weather_dwh\\\".\\\"stg\\\".\\\"stg_weather_current\\\"\\n    \\n    \\n        -- \\u0417\\u0430\\u0433\\u0440\\u0443\\u0436\\u0430\\u0435\\u043c \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043d\\u043e\\u0432\\u044b\\u0435 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0435\\n        where observation_time > (\\n            select coalesce(max(observation_time), '1900-01-01'::timestamp)\\n            from \\\"weather_dwh\\\".\\\"ods\\\".\\\"ods_weather_observations\\\"\\n        )\\n    \\n)\\n\\nselect\\n    md5(cast(coalesce(cast(city as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(provider as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(observation_time as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as observation_id,\\n    city,\\n    country,\\n    latitude,\\n    longitude,\\n    provider,\\n    observation_time,\\n    \\n    -- \\u0422\\u0435\\u043c\\u043f\\u0435\\