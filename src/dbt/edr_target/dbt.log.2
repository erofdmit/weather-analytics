idity_percent,\\n        (point->>'wind_speed_kph')::float as wind_speed_kph,\\n        \\n        -- \\u041c\\u0435\\u0442\\u0430\\u0434\\u0430\\u043d\\u043d\\u044b\\u0435\\n        status_code,\\n        created_at,\\n        updated_at,\\n        valid_from_dttm,\\n        valid_to_dttm\\n        \\n    from forecast_points_expanded\\n)\\n\\nselect\\n    pf.id,\\n    pf.forecast_id,\\n    pf.latitude,\\n    pf.longitude,\\n    c.city,\\n    c.country,\\n    pf.provider,\\n    pf.forecast_timestamp,\\n    pf.forecast_run_hour,\\n    \\n    -- \\u0418\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u0443\\u0435\\u043c hours \\u0438\\u0437 raw \\u0442\\u0430\\u0431\\u043b\\u0438\\u0446\\u044b (\\u0433\\u043e\\u0440\\u0438\\u0437\\u043e\\u043d\\u0442 \\u043f\\u0440\\u043e\\u0433\\u043d\\u043e\\u0437\\u0430 \\u0438\\u0437 \\u0437\\u0430\\u043f\\u0440\\u043e\\u0441\\u0430)\\n    pf.hours as hours_ahead,\\n    \\n    -- \\u041e\\u0441\\u043d\\u043e\\u0432\\u043d\\u044b\\u0435 \\u043f\\u043e\\u0433\\u043e\\u0434\\u043d\\u044b\\u0435 \\u043f\\u0430\\u0440\\u0430\\u043c\\u0435\\u0442\\u0440\\u044b \\u0434\\u043b\\u044f \\u0441\\u0440\\u0430\\u0432\\u043d\\u0435\\u043d\\u0438\\u044f\\n    pf.temperature_celsius,\\n    pf.humidity_percent,\\n    pf.wind_speed_kph,\\n    \\n    -- \\u041c\\u0435\\u0442\\u0430\\u0434\\u0430\\u043d\\u043d\\u044b\\u0435\\n    pf.status_code,\\n    pf.created_at as forecast_created_at,\\n    pf.updated_at,\\n    pf.valid_from_dttm,\\n    pf.valid_to_dttm\\n    \\nfrom parsed_forecasts pf\\nleft join \\\"weather_dwh\\\".\\\"public\\\".\\\"cities\\\" c\\n    on round(pf.latitude::numeric, 2) = round(c.latitude::numeric, 2)\\n    and round(pf.longitude::numeric, 2) = round(c.longitude::numeric, 2)\\norder by pf.forecast_id, pf.provider, pf.forecast_timestamp\", \"generated_at\": \"2025-12-14 10:44:42\"}, {\"unique_id\": \"model.weather_analytics.ods_weather_forecasts\", \"invocation_id\": \"4128fe57-8676-437a-a8f2-b21f9c155a6b\", \"name\": \"ods_weather_