parsed_samples ps\\nleft join \\\"weather_dwh\\\".\\\"public\\\".\\\"cities\\\" c\\n    on round(ps.latitude::numeric, 2) = round(c.latitude::numeric, 2)\\n    and round(ps.longitude::numeric, 2) = round(c.longitude::numeric, 2)\", \"generated_at\": \"2025-12-13 03:03:16\"}, {\"unique_id\": \"model.weather_analytics.ods_weather_observations\", \"invocation_id\": \"7962845b-67ff-4256-8aa0-c28d3c708b0d\", \"name\": \"ods_weather_observations\", \"schema\": \"ods\", \"status\": \"success\", \"execution_time\": 0.3, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"\\n\\n/*\\n    ODS \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c \\u0434\\u043b\\u044f \\u043d\\u0430\\u0431\\u043b\\u044e\\u0434\\u0435\\u043d\\u0438\\u0439 \\u0437\\u0430 \\u043f\\u043e\\u0433\\u043e\\u0434\\u043e\\u0439 \\u043e\\u0442 \\u0440\\u0430\\u0437\\u043d\\u044b\\u0445 \\u043f\\u0440\\u043e\\u0432\\u0430\\u0439\\u0434\\u0435\\u0440\\u043e\\u0432.\\n    \\u0418\\u043d\\u043a\\u0440\\u0435\\u043c\\u0435\\u043d\\u0442\\u0430\\u043b\\u044c\\u043d\\u0430\\u044f \\u0437\\u0430\\u0433\\u0440\\u0443\\u0437\\u043a\\u0430 \\u0441 delete+insert.\\n*/\\n\\nwith source_data as (\\n    select\\n        city,\\n        country,\\n        latitude,\\n        longitude,\\n        provider,\\n        observation_time,\\n        temperature_celsius,\\n        humidity_percent,\\n        wind_speed_ms,\\n        wind_speed_kph,\\n        pressure_hpa,\\n        precipitation_mm,\\n        cloud_cover_percent,\\n        visibility_km,\\n        uv_index,\\n        feels_like_celsius,\\n        wind_direction_degrees,\\n        weather_condition,\\n        created_at,\\n        updated_at,\\n        coalesce(updated_at, created_at, observation_time) as source_changed_at\\n    from \\\"weather_dwh\\\".\\\"stg\\\".\\\"stg_weather_current\\\"\\n    where 1 = 1\\n\\n    \\n      and coalesce(updated_at, created_at, observation_time) >= (\\n          select coalesce(max(source_changed_at), '190