 provider_avg_mae\\nWHERE total_forecasts >= 10  -- \\u041c\\u0438\\u043d\\u0438\\u043c\\u0443\\u043c 10 \\u043f\\u0440\\u043e\\u0433\\u043d\\u043e\\u0437\\u043e\\u0432 \\u0434\\u043b\\u044f \\u0441\\u0442\\u0430\\u0442\\u0438\\u0441\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0439 \\u0437\\u043d\\u0430\\u0447\\u0438\\u043c\\u043e\\u0441\\u0442\\u0438\\nORDER BY city, overall_rank_score\", \"generated_at\": \"2025-12-14 08:30:35\"}, {\"unique_id\": \"model.weather_analytics.ods_weather_observations\", \"invocation_id\": \"b8ed1c37-cb89-4abf-b624-170e3f5c9960\", \"name\": \"ods_weather_observations\", \"schema\": \"ods\", \"status\": \"success\", \"execution_time\": 0.3, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"\\n\\n/*\\n    ODS \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c \\u0434\\u043b\\u044f \\u043d\\u0430\\u0431\\u043b\\u044e\\u0434\\u0435\\u043d\\u0438\\u0439 \\u0437\\u0430 \\u043f\\u043e\\u0433\\u043e\\u0434\\u043e\\u0439 \\u043e\\u0442 \\u0440\\u0430\\u0437\\u043d\\u044b\\u0445 \\u043f\\u0440\\u043e\\u0432\\u0430\\u0439\\u0434\\u0435\\u0440\\u043e\\u0432.\\n    \\u0418\\u043d\\u043a\\u0440\\u0435\\u043c\\u0435\\u043d\\u0442\\u0430\\u043b\\u044c\\u043d\\u0430\\u044f \\u0437\\u0430\\u0433\\u0440\\u0443\\u0437\\u043a\\u0430 \\u0441 delete+insert.\\n*/\\n\\nwith source_data as (\\n    select\\n        city,\\n        country,\\n        latitude,\\n        longitude,\\n        provider,\\n        observation_hour,\\n        \\n        -- \\u041e\\u0441\\u043d\\u043e\\u0432\\u043d\\u044b\\u0435 \\u043f\\u043e\\u0433\\u043e\\u0434\\u043d\\u044b\\u0435 \\u043f\\u0430\\u0440\\u0430\\u043c\\u0435\\u0442\\u0440\\u044b\\n        temperature_celsius,\\n        humidity_percent,\\n        wind_speed_kph,\\n        pressure_hpa,\\n        precipitation_mm,\\n        cloud_cover_percent,\\n        visibility_km,\\n        uv_index,\\n        feels_like_celsius,\\n        wind_direction_degrees,\\n        weather_condition,\\n  