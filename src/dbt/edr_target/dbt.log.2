k_by_wind,\\n    \\n    -- \\u041e\\u0431\\u0449\\u0438\\u0439 \\u0440\\u0430\\u043d\\u0433 (\\u0441\\u0440\\u0435\\u0434\\u043d\\u0435\\u0435 \\u0430\\u0440\\u0438\\u0444\\u043c\\u0435\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0435 \\u0440\\u0430\\u043d\\u0433\\u043e\\u0432)\\n    ROUND(\\n        (ROW_NUMBER() OVER (PARTITION BY city ORDER BY avg_temp_mae ASC) +\\n         ROW_NUMBER() OVER (PARTITION BY city ORDER BY avg_humidity_mae ASC) +\\n         ROW_NUMBER() OVER (PARTITION BY city ORDER BY avg_wind_mae ASC)) / 3.0\\n    ::NUMERIC, 2) AS overall_rank_score,\\n    \\n    -- \\u041a\\u043e\\u043b\\u0438\\u0447\\u0435\\u0441\\u0442\\u0432\\u043e \\u043f\\u0440\\u043e\\u0433\\u043d\\u043e\\u0437\\u043e\\u0432\\n    total_forecasts,\\n    \\n    -- \\u041c\\u0435\\u0442\\u0430\\u0434\\u0430\\u043d\\u043d\\u044b\\u0435\\n    CURRENT_TIMESTAMP AS dbt_updated_at\\n\\nFROM provider_avg_mae\\nWHERE total_forecasts >= 10  -- \\u041c\\u0438\\u043d\\u0438\\u043c\\u0443\\u043c 10 \\u043f\\u0440\\u043e\\u0433\\u043d\\u043e\\u0437\\u043e\\u0432 \\u0434\\u043b\\u044f \\u0441\\u0442\\u0430\\u0442\\u0438\\u0441\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0439 \\u0437\\u043d\\u0430\\u0447\\u0438\\u043c\\u043e\\u0441\\u0442\\u0438\\nORDER BY city, overall_rank_score\", \"generated_at\": \"2025-12-14 09:11:40\"}, {\"unique_id\": \"model.weather_analytics.stg_weather_current\", \"invocation_id\": \"b8ed1c37-cb89-4abf-b624-170e3f5c9960\", \"name\": \"stg_weather_current\", \"schema\": \"stg\", \"status\": \"success\", \"execution_time\": 0.8, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"-- Staging \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c \\u0434\\u043b\\u044f \\u0442\\u0435\\u043a\\u0443\\u0449\\u0435\\u0439 \\u043f\\u043e\\u0433\\u043e\\u0434\\u044b\\n-- \\u0420\\u0430\\u0437\\u0432\\u043e\\u0440\\u0430\\u0447\\u0438\\u0432\\u0430\\u0435\\u0442 samples \\u043e\\u0442 \\u0440\\u0430\\u0437\\u043d\\u044b\\u0445 \\u043f\\u0440