6\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0445 \\u0437\\u043d\\u0430\\u0447\\u0435\\u043d\\u0438\\u0439\\n    greatest(0, extract(epoch from (pf.forecast_timestamp - pf.created_at)) / 3600) as hours_ahead,\\n    \\n    -- \\u041f\\u043e\\u0433\\u043e\\u0434\\u043d\\u044b\\u0435 \\u043f\\u0430\\u0440\\u0430\\u043c\\u0435\\u0442\\u0440\\u044b\\n    pf.temperature_celsius,\\n    pf.humidity_percent,\\n    pf.wind_speed_ms,\\n    pf.wind_speed_kph,\\n    pf.pressure_hpa,\\n    pf.precipitation_mm,\\n    pf.cloud_cover_percent,\\n    pf.visibility_km,\\n    pf.uv_index,\\n    pf.feels_like_celsius,\\n    pf.wind_direction_degrees,\\n    pf.weather_condition,\\n    pf.precipitation_probability,\\n    \\n    -- \\u041c\\u0435\\u0442\\u0430\\u0434\\u0430\\u043d\\u043d\\u044b\\u0435\\n    pf.status_code,\\n    pf.created_at as forecast_created_at,\\n    pf.updated_at,\\n    pf.valid_from_dttm,\\n    pf.valid_to_dttm\\n    \\nfrom parsed_forecasts pf\\nleft join \\\"weather_dwh\\\".\\\"public\\\".\\\"cities\\\" c\\n    on round(pf.latitude::numeric, 2) = round(c.latitude::numeric, 2)\\n    and round(pf.longitude::numeric, 2) = round(c.longitude::numeric, 2)\\norder by pf.forecast_id, pf.provider, pf.forecast_timestamp\", \"generated_at\": \"2025-12-13 00:36:08\"}, {\"unique_id\": \"model.weather_analytics.stg_weather_current\", \"invocation_id\": \"e2b75900-7c7f-4ef9-b7bf-9089f4b583c4\", \"name\": \"stg_weather_current\", \"schema\": \"stg\", \"status\": \"success\", \"execution_time\": 0.8, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"-- Staging \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c \\u0434\\u043b\\u044f \\u0442\\u0435\\u043a\\u0443\\u0449\\u0435\\u0439 \\u043f\\u043e\\u0433\\u043e\\u0434\\u044b\\n-- \\u0420\\u0430\\u0437\\u0432\\u043e\\u0440\\u0430\\u0447\\u0438\\u0432\\u0430\\u0435\\u0442 samples \\u043e\\u0442 \\u0440\\u0430\\u0437\\u043d\\u044b\\u0445 \\u043f\\u0440\\u043e\\u0432\\u0430\\u0439\\u0434\\u0435\\u0440\\u