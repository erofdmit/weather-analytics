dated_at,\\n    ps.valid_from_dttm,\\n    ps.valid_to_dttm\\nfrom parsed_samples ps\\nleft join \\\"weather_dwh\\\".\\\"public\\\".\\\"cities\\\" c\\n    on round(ps.latitude::numeric, 2) = round(c.latitude::numeric, 2)\\n    and round(ps.longitude::numeric, 2) = round(c.longitude::numeric, 2)\", \"generated_at\": \"2025-12-14 09:47:50\"}, {\"unique_id\": \"model.weather_analytics.ods_weather_observations\", \"invocation_id\": \"37ea2253-dfa8-4480-94ef-771c364aa3a2\", \"name\": \"ods_weather_observations\", \"schema\": \"ods\", \"status\": \"success\", \"execution_time\": 0.3, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"\\n\\n/*\\n    ODS \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c \\u0434\\u043b\\u044f \\u043d\\u0430\\u0431\\u043b\\u044e\\u0434\\u0435\\u043d\\u0438\\u0439 \\u0437\\u0430 \\u043f\\u043e\\u0433\\u043e\\u0434\\u043e\\u0439 \\u043e\\u0442 \\u0440\\u0430\\u0437\\u043d\\u044b\\u0445 \\u043f\\u0440\\u043e\\u0432\\u0430\\u0439\\u0434\\u0435\\u0440\\u043e\\u0432.\\n    \\u0418\\u043d\\u043a\\u0440\\u0435\\u043c\\u0435\\u043d\\u0442\\u0430\\u043b\\u044c\\u043d\\u0430\\u044f \\u0437\\u0430\\u0433\\u0440\\u0443\\u0437\\u043a\\u0430 \\u0441 delete+insert.\\n*/\\n\\nwith source_data as (\\n    select\\n        city,\\n        country,\\n        latitude,\\n        longitude,\\n        provider,\\n        observation_hour,\\n        \\n        -- \\u041e\\u0441\\u043d\\u043e\\u0432\\u043d\\u044b\\u0435 \\u043f\\u043e\\u0433\\u043e\\u0434\\u043d\\u044b\\u0435 \\u043f\\u0430\\u0440\\u0430\\u043c\\u0435\\u0442\\u0440\\u044b\\n        temperature_celsius,\\n        humidity_percent,\\n        wind_speed_kph,\\n        pressure_hpa,\\n        precipitation_mm,\\n        cloud_cover_percent,\\n        visibility_km,\\n        uv_index,\\n        feels_like_celsius,\\n        wind_direction_degrees,\\n        weather_condition,\\n        \\n        -- \\u041c\\u0435\\u0442\\u0430\\u0434\\u0430\\u043d\\u043d\\u044b\\u0435\\n        c