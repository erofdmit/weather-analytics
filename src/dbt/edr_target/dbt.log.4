,\\n        latitude,\\n        longitude,\\n        provider,\\n        observation_time,\\n        temperature_celsius,\\n        humidity_percent,\\n        wind_speed_ms,\\n        wind_speed_kph,\\n        pressure_hpa,\\n        precipitation_mm,\\n        cloud_cover_percent,\\n        visibility_km,\\n        uv_index,\\n        feels_like_celsius,\\n        wind_direction_degrees,\\n        weather_condition,\\n        created_at,\\n        updated_at,\\n        coalesce(updated_at, created_at, observation_time) as source_changed_at\\n    from \\\"weather_dwh\\\".\\\"stg\\\".\\\"stg_weather_current\\\"\\n    where 1 = 1\\n\\n    \\n      and coalesce(updated_at, created_at, observation_time) >= (\\n          select coalesce(max(source_changed_at), '1900-01-01'::timestamp)\\n          from \\\"weather_dwh\\\".\\\"ods\\\".\\\"ods_weather_observations\\\"\\n      )\\n    \\n),\\n\\ndeduped as (\\n    select *\\n    from (\\n        select\\n            *,\\n            row_number() over (\\n                partition by city, provider, observation_time\\n                order by source_changed_at desc, updated_at desc nulls last, created_at desc nulls last\\n            ) as rn\\n        from source_data\\n    ) t\\n    where rn = 1\\n)\\n\\nselect\\n    md5(cast(coalesce(cast(city as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(provider as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(observation_time as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as observation_id,\\n    city,\\n    country,\\n    latitude,\\n    longitude,\\n    provider,\\n    observation_time,\\n\\n    -- \\u0422\\u0435\\u043c\\u043f\\u0435\\u0440\\u0430\\u0442\\u0443\\u0440\\u043d\\u044b\\u0435 \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u0442\\u0435\\u043b\\u0438\\n    temperature_celsius,\\n    feels_like_celsius,\\n    round((temperature_celsius * 9.0 / 5.0 + 32)::numeric, 1) as temperature_fahrenheit,\\n\\n    -- \\u041c\\u0435\\u0442\\u04