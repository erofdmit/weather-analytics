 \\u0441\\u0440\\u0435\\u0434\\u043d\\u0435\\u0439 \\u0442\\u0435\\u043c\\u043f\\u0435\\u0440\\u0430\\u0442\\u0443\\u0440\\u043d\\u043e\\u0439 \\u043e\\u0448\\u0438\\u0431\\u043a\\u0435)\\n    ROW_NUMBER() OVER (PARTITION BY city ORDER BY avg_temp_mae ASC) AS provider_rank_by_temp,\\n    \\n    -- \\u0420\\u0430\\u043d\\u0433 \\u043f\\u0440\\u043e\\u0432\\u0430\\u0439\\u0434\\u0435\\u0440\\u0430 \\u043f\\u043e \\u0433\\u043e\\u0440\\u043e\\u0434\\u0443 (\\u043f\\u043e \\u0441\\u0440\\u0435\\u0434\\u043d\\u0435\\u0439 \\u043e\\u0448\\u0438\\u0431\\u043a\\u0435 \\u0432\\u043b\\u0430\\u0436\\u043d\\u043e\\u0441\\u0442\\u0438)\\n    ROW_NUMBER() OVER (PARTITION BY city ORDER BY avg_humidity_mae ASC) AS provider_rank_by_humidity,\\n    \\n    -- \\u0420\\u0430\\u043d\\u0433 \\u043f\\u0440\\u043e\\u0432\\u0430\\u0439\\u0434\\u0435\\u0440\\u0430 \\u043f\\u043e \\u0433\\u043e\\u0440\\u043e\\u0434\\u0443 (\\u043f\\u043e \\u0441\\u0440\\u0435\\u0434\\u043d\\u0435\\u0439 \\u043e\\u0448\\u0438\\u0431\\u043a\\u0435 \\u0432\\u0435\\u0442\\u0440\\u0430)\\n    ROW_NUMBER() OVER (PARTITION BY city ORDER BY avg_wind_mae ASC) AS provider_rank_by_wind,\\n    \\n    -- \\u041e\\u0431\\u0449\\u0438\\u0439 \\u0440\\u0430\\u043d\\u0433 (\\u0441\\u0440\\u0435\\u0434\\u043d\\u0435\\u0435 \\u0430\\u0440\\u0438\\u0444\\u043c\\u0435\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0435 \\u0440\\u0430\\u043d\\u0433\\u043e\\u0432)\\n    ROUND(\\n        (ROW_NUMBER() OVER (PARTITION BY city ORDER BY avg_temp_mae ASC) +\\n         ROW_NUMBER() OVER (PARTITION BY city ORDER BY avg_humidity_mae ASC) +\\n         ROW_NUMBER() OVER (PARTITION BY city ORDER BY avg_wind_mae ASC)) / 3.0\\n    ::NUMERIC, 2) AS overall_rank_score,\\n    \\n    -- \\u041a\\u043e\\u043b\\u0438\\u0447\\u0435\\u0441\\u0442\\u0432\\u043e \\u043f\\u0440\\u043e\\u0433\\u043d\\u043e\\u0437\\u043e\\u0432\\n    total_forecasts,\\n    \\n    -- \\u041c\\u0435\\u0442\\u0430\\u0434\\u0430\\u043d\\u043d\\u044b\\u0435\\n    CURRENT_TIMESTAMP AS dbt_updated_at\\n\\nFROM provider_avg_mae\\nWHERE total_forecasts >= 10  -- \\u041c\\u0438\\u043d\\u0438\\u043c\\u0443\\u043c 10 \\u043f\\u0440\\u043e\\u0433\\u043d\\u043e\\u0437\\u043e\\u0432 \\u0434\\u043b\\u044f \\u0441\\u0442\\u0430\\u0442\\u0438\\u0441\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0439 \\u0437\\u043d\\u0430\\u0447\\u0438\\u043c\\u043e\\u0441\\u0442\\u0438\\nORDER BY city, overall_rank_score\", \"generated_at\": \"2025-12-14 08:13:31\"}, {\"unique_id\": \"model.weather_analytics.ods_weather_observations\", \"invocation_id\": \"60e6091a-e7c1-4abc-a287-f6f8b3eb0c2e\", \"name\": \"ods_weather_observations\", \"schema\": \"ods\", \"status\": \"success\", \"execution_time\": 0.8, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"\\n\\n/*\\n    ODS \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c \\u0434\\u043b\\u044f \\u043d\\u0430\\u0431\\u043b\\u044e\\u0434\\u0435\\u043d\\u0438\\u0439 \\u0437\\u0430 \\u043f\\u043e\\u0433\\u043e\\u0434\\u043e\\u0439 \\u043e\\u0442 \\u0440\\u0430\\u0437\\u043d\\u044b\\u0445 \\u043f\\u0440\\u043e\\u0432\\u0430\\u0439\\u0434\\u0435\\u0440\\u043e\\u0432.\\n    \\u0418\\u043d\\u043a\\u0440\\u0435\\u043c\\u0435\\u043d\\u0442\\u0430\\u043b\\u044c\\u043d\\u0430\\u044f \\u0437\\u0430\\u0433\\u0440\\u0443\\u0437\\u043a\\u0430 \\u0441 delete+insert.\\n*/\\n\\nwith source_data as (\\n    select\\n        city,\\n        country,\\n        latitude,\\n        longitude,\\n        provider,\\n        observation_hour,\\n        \\n        -- \\u041e\\u0441\\u043d\\u043e\\u0432\\u043d\\u044b\\u0435 \\u043f\\u043e\\u0433\\u043e\\u0434\\u043d\\u044b\\u0435 \\u043f\\u0430\\u0440\\u0430\\u043c\\u0435\\u0442\\u0440\\u044b\\n        temperature_celsius,\\n        humidity_percent,\\n        wind_speed_kph,\\n        pressure_hpa,\\n        precipitation_mm,\\n        cloud_cover_percent,\\n        visibility_km,\\n        uv_index,\\n        feels_like_celsius,\\n        wind_direction_degrees,\\n        weather_condition,\\n        \\n        -- \\u041c\\u0435\\u0442\\u0430\\u0434\\u0430\\u043d\\u043d\\u044b\\u0435\\n        created_at,\\n        updated_at,\\n        coalesce(updated_at, created_at, observation_hour) as source_changed_at\\n    from \\\"weather_dwh\\\".\\\"stg\\\".\\\"stg_weather_current\\\"\\n    where 1 = 1\\n\\n    \\n      and coalesce(updated_at, created_at, observation_hour) >= (\\n          select coalesce(max(source_changed_at), '1900-01-01'::timestamp)\\n          from \\\"weather_dwh\\\".\\\"ods\\\".\\\"ods_weather_observations\\\"\\n      )\\n    \\n),\\n\\ndeduped as (\\n    select *\\n    from (\\n        select\\n            *,\\n            row_number() over (\\n                partition by city, provider, observation_hour\\n                order by source_changed_at desc, updated_at desc nulls last, created_at desc nulls last\\n            ) as rn\\n        from source_data\\n    ) t\\n    where rn = 1\\n)\\n\\nselect\\n    md5(cast(coalesce(cast(city as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(provider as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(observation_hour as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as observation_id,\\n    city,\\n    country,\\n    latitude,\\n    longitude,\\n    provider,\\n    observation_hour,\\n    \\n    -- \\u0412\\u044b\\u0447\\u0438\\u0441\\u043b\\u044f\\u0435\\u043c\\u044b\\u0435 \\u043f\\u043e\\u043b\\u044f \\u0434\\u043b\\u044f \\u0430\\u043d\\u0430\\u043b\\u0438\\u0442\\u0438\\u043a\\u0438\\n    extract(dow from observation_hour) as day_of_week,\\n    extract(hour from observation_hour) as hour_of_day,\\n    date_trunc('day', observation_hour) as observation_date,\\n\\n    -- \\u041e\\u0441\\u043d\\u043e\\u0432\\u043d\\u044b\\u0435 \\u043f\\u0430\\u0440\\u0430\\u043c\\u0435\\u0442\\u0440\\u044b \\u0434\\u043b\\u044f \\u0441\\u0440\\u0430\\u0432\\u043d\\u0435\\u043d\\u0438\\u044f \\u0441 \\u043f\\u0440\\u043e\\u0433\\u043d\\u043e\\u0437\\u0430\\u043c\\u0438\\n    temperature_celsius,\\n    humidity_percent,\\n    wind_speed_kph,\\n    \\n    -- \\u0414\\u043e\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0435 \\u043f\\u0430\\u0440\\u0430\\u043c\\u0435\\u0442\\u0440\\u044b\\n    pressure_hpa,\\n    precipitation_mm,\\n    cloud_cover_percent,\\n    visibility_km,\\n    uv_index,\\n    feels_like_celsius,\\n    wind_direction_degrees,\\n    weather_condition,\\n\\n    -- \\u041c\\u0435\\u0442\\u0430\\u0434\\u0430\\u043d\\u043d\\u044b\\u0435\\n    created_at as source_created_at,\\n    updated_at as source_updated_at,\\n    source_changed_at,\\n    current_timestamp as processed_dttm\\n\\nfrom deduped\", \"generated_at\": \"2025-12-14 08:13:31\"}, {\"unique_id\": \"model.weather_analytics.stg_weather_current\", \"invocation_id\": \"e55a7f28-428e-40fc-a341-c8f205bad732\", \"name\": \"stg_weather_current\", \"schema\": \"stg\", \"status\": \"success\", \"execution_time\": 0.7, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"-- Staging \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c \\u0434\\u043b\\u044f \\u0442\\u0435\\u043a\\u0443\\u0449\\u0435\\u0439 \\u043f\\u043e\\u0433\\u043e\\u0434\\u044b\\n-- \\u0420\\u0430\\u0437\\u0432\\u043e\\u0440\\u0430\\u0447\\u0438\\u0432\\u0430\\u0435\\u0442 samples \\u043e\\u0442 \\u0440\\u0430\\u0437\\u043d\\u044b\\u0445 \\u043f\\u0440\\u043e\\u0432\\u0430\\u0439\\u0434\\u0435\\u0440\\u043e\\u0432 \\u0432 \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u044b\\u0435 \\u0441\\u0442\\u0440\\u043e\\u043a\\u0438\\n\\n\\n\\nwith source_data as (\\n    select\\n        id,\\n        weather_id,\\n        latitude,\\n        longitude,\\n        request,\\n        response,\\n        status_code,\\n        created_at,\\n        updated_at,\\n        valid_from_dttm,\\n        valid_to_dttm\\n    from \\\"weather_dwh\\\".\\\"raw\\\".\\\"weather_current\\\"\\n    where valid_to_dttm = '5999-01-01'::times