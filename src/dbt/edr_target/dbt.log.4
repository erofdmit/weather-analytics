2\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0439 \\u0437\\u043d\\u0430\\u0447\\u0438\\u043c\\u043e\\u0441\\u0442\\u0438\\nORDER BY overall_rank_score\", \"generated_at\": \"2025-12-14 10:58:48\"}, {\"unique_id\": \"model.weather_analytics.stg_weather_current\", \"invocation_id\": \"59621f92-3c23-4921-8335-2817fd16d65f\", \"name\": \"stg_weather_current\", \"schema\": \"stg\", \"status\": \"success\", \"execution_time\": 0.8, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"-- Staging \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c \\u0434\\u043b\\u044f \\u0442\\u0435\\u043a\\u0443\\u0449\\u0435\\u0439 \\u043f\\u043e\\u0433\\u043e\\u0434\\u044b\\n-- \\u0420\\u0430\\u0437\\u0432\\u043e\\u0440\\u0430\\u0447\\u0438\\u0432\\u0430\\u0435\\u0442 samples \\u043e\\u0442 \\u0440\\u0430\\u0437\\u043d\\u044b\\u0445 \\u043f\\u0440\\u043e\\u0432\\u0430\\u0439\\u0434\\u0435\\u0440\\u043e\\u0432 \\u0432 \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u044b\\u0435 \\u0441\\u0442\\u0440\\u043e\\u043a\\u0438\\n\\n\\n\\nwith source_data as (\\n    select\\n        id,\\n        weather_id,\\n        latitude,\\n        longitude,\\n        request,\\n        response,\\n        status_code,\\n        created_at,\\n        updated_at,\\n        valid_from_dttm,\\n        valid_to_dttm\\n    from \\\"weather_dwh\\\".\\\"raw\\\".\\\"weather_current\\\"\\n    where valid_to_dttm = '5999-01-01'::timestamp  -- \\u0422\\u043e\\u043b\\u044c\\u043a\\u043e \\u0430\\u043a\\u0442\\u0438\\u0432\\u043d\\u044b\\u0435 \\u0437\\u0430\\u043f\\u0438\\u0441\\u0438\\n      and status_code = 200  -- \\u0422\\u043e\\u043b\\u044c\\u043a\\u043e \\u0443\\u0441\\u043f\\u0435\\u0448\\u043d\\u044b\\u0435 \\u0437\\u0430\\u043f\\u0440\\u043e\\u0441\\u044b\\n    \\n    \\n        -- \\u0418\\u043d\\u043a\\u0440\\u0435\\u043c\\u0435\\u043d\\u0442\\u0430\\u043b\\u044c\\u043d\\u0430\\u044f \\u0437\\u0430\\u0433\\u0440\\u0443\\u0437\\u043a\\u0430: \\u0442\\u043e\\u043b\\u044c\\u043a\\u0